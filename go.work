// Local development workspace. This wires the CLI and SDK modules together so
// `go build`/`go test` use the in-tree SDK without a `replace` directive in
// go.mod.
//
// go.work is intentionally committed. Its `toolchain` line pins Go for local
// builds, CI and the release (see .mise.toml). Its `use` block affects only
// local development: `go install <module>@<version>` and downstream consumers
// ignore go.work entirely, and release builds resolve the SDK from its
// published `sdk/vX.Y.Z` tag.
go 1.27.0

toolchain go1.27.2

use (
	.
	./sdk
)
